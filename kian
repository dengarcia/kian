#!/usr/bin/env bash
set -e

# Resolve symlinks to find the real script location
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do SOURCE="$(readlink "$SOURCE")"; done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
TASKS="$DIR/tools/node/tasks.js"
SERVER="$DIR/tools/node/server.js"

case "$1" in
  dashboard)
    exec node "$SERVER"
    ;;
  help|"")
    node "$TASKS" help
    echo "  dashboard              Start the web UI (http://localhost:\${PORT:-3000})"
    ;;
  *)
    exec node "$TASKS" "$@"
    ;;
esac
